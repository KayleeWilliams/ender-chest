{
  "name": "ender-chest-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test",
    "dev": "turbo run dev",
    "ec": "./ec",
    "format": "ultracite fix . && turbo run format",
    "lint": "ultracite check . && turbo run lint",
    "lint:fix": "pnpm format",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:watch": "pnpm --filter @ender-chest/native test:watch",
    "tegami": "node tools/tegami.ts",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "tegami": "1.3.4",
    "turbo": "2.10.12",
    "ultracite": "7.10.8",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.25.0"
}
